# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-change-in-production-1234567890

# Database Configuration (SQLite default; can use mysql+pymysql://user:pass@host/dbname)
DATABASE_URL=sqlite:///instance/portal.db

# College Portal Info
COLLEGE_NAME="Apex Institute of Technology & Engineering"
COLLEGE_CODE="AITE"
COLLEGE_EMAIL="support@college.edu"

# Razorpay Payment Gateway (Leave empty for automatic Development / Mock Payment mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR
